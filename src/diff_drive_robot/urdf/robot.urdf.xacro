<?xml version="1.0"?>

<robot name="diff_drive_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">


    <!-- ========================= -->
    <!-- Robot Dimensions -->
    <!-- ========================= -->

    <!-- Base dimensions -->
    <xacro:property name="base_length" value="0.40"/>
    <xacro:property name="base_width"  value="0.30"/>
    <xacro:property name="base_height" value="0.10"/>


    <!-- Wheel dimensions -->
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width"  value="0.03"/>


    <!-- Mass properties -->
    <xacro:property name="base_mass" value="5.0"/>
    <xacro:property name="wheel_mass" value="0.5"/>
    <xacro:property name="caster_mass" value="0.2"/>


    <!-- ========================= -->
    <!-- Include Robot Components -->
    <!-- ========================= -->

    <xacro:include filename="materials.xacro"/>

    <xacro:include filename="base.xacro"/>

    <xacro:include filename="wheels.xacro"/>


</robot>
